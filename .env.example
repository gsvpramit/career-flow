# ==============================================================================
# CareerFlow Production & Testing Environment Configuration
# Copy this file to .env — NEVER commit .env with real secrets to GitHub!
# ==============================================================================

# Environment mode: 'development' allows local guest bypass; 'production' enforces strict auth
CAREERFLOW_ENV=development

# Database Connection (defaults to SQLite; swap to PostgreSQL for 100+ concurrent users)
# SQLite: sqlite:///data/job_mark1.db
# PostgreSQL: postgresql://careerflow_user:strong_password@localhost:5432/careerflow
CAREERFLOW_DATABASE_URL=sqlite:///data/job_mark1.db

# Authentication & Session Security
CAREERFLOW_JWT_SECRET=replace-with-openssl-rand-hex-32-in-production
CAREERFLOW_JWT_EXPIRY_HOURS=72
CAREERFLOW_BASIC_AUTH_USER=careerflow
CAREERFLOW_BASIC_AUTH_PASS=

# AI Model Inference Engines
# Local Ollama base endpoint
CAREERFLOW_OLLAMA_URL=http://localhost:11434
# Optional: Anthropic Claude API Key for Cloud AI tailoring
ANTHROPIC_API_KEY=

# CORS & Domain Routing (comma-separated origins allowed to make API requests)
CAREERFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting & Abuse Prevention
CAREERFLOW_AUTH_MAX_FAILURES=8
CAREERFLOW_RATE_LIMIT_PER_MINUTE=60

# Optional: Transactional Email Notifications (Resend / Brevo API)
NOTIFICATION_PROVIDER=none
NOTIFICATION_API_KEY=
NOTIFICATION_FROM_EMAIL=alerts@careerflow.app
